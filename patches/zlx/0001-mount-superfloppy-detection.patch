diff --git a/zlx/mount.cpp b/zlx/mount.cpp
index a696a97..2b5dbe9 100644
--- a/zlx/mount.cpp
+++ b/zlx/mount.cpp
@@ -159,6 +159,24 @@ static int FindPartitions(int device) {
 		return -1;
 	}
 
+	// "Superfloppy" layout: the filesystem starts at sector 0 with no
+	// partition table. A FAT/NTFS boot sector also ends in 0x55AA, so it
+	// would otherwise be misread as an MBR and its boot code parsed as a
+	// partition table (seen on drives formatted by some tools/consoles).
+	if (sector.boot.oem_id == NTFS_OEM_ID) {
+		debug_printf("Superfloppy NTFS volume at sector 0\n");
+		AddPartition(0, device, T_NTFS, &devnum);
+		return devnum;
+	}
+	if ((sector.buffer[0] == 0xEB || sector.buffer[0] == 0xE9) &&
+			(!memcmp(sector.buffer + BPB_FAT16_fileSysType, FAT_SIG, sizeof (FAT_SIG)) ||
+			 !memcmp(sector.buffer + BPB_FAT32_fileSysType, FAT_SIG, sizeof (FAT_SIG)))) {
+		debug_printf("Superfloppy FAT volume at sector 0\n");
+		AddPartition(0, device, T_FAT, &devnum);
+		if (devnum > 0)
+			return devnum;
+	}
+
 	// If this is the devices master boot record
 	debug_printf("0x%x\n", sector.mbr.signature);
 	if (sector.mbr.signature == MBR_SIGNATURE) {
@@ -319,12 +337,13 @@ static int FindPartitions(int device) {
 					debug_printf("Partition : Valid FAT boot sector found\n");
 					AddPartition(i, device, T_FAT, &devnum);
 					break;
-				} else {
-					debug_printf("Trying : ext partition\n");
-					AddPartition(part_lba, device, T_EXT2, &devnum);
 				}
 			}
 		}
+		// Last resort: a bare ext2/3/4 volume at sector 0 (tried once,
+		// instead of once per scanned sector at a stale LBA).
+		if (devnum == 0)
+			AddPartition(0, device, T_EXT2, &devnum);
 	}
 	return devnum;
 }
